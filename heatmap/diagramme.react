import React from 'react';
import {
Image as ImageIcon,
Activity,
Target,
Layers,
Palette,
Save,
ArrowDown,
Cpu,
Sliders
} from 'lucide-react';

const DiagramStep = ({ icon: Icon, title, description, code, colorClass, isLast = false }) => (
<div className="flex flex-col items-center">
  <div className={`w-full max-w-md bg-white rounded-xl shadow-md border-l-4 ${colorClass} p-4 hover:shadow-lg
    transition-shadow duration-300`}>
    <div className="flex items-start gap-4">
      <div className={`p-3 rounded-lg ${colorClass.replace('border-', 'bg-' ).replace('500', '100' )}
        text-${colorClass.split('-')[1]}-600`}>
        <Icon size={24} />
      </div>
      <div className="flex-1">
        <h3 className="font-bold text-gray-800 text-lg mb-1">{title}</h3>
        <p className="text-sm text-gray-600 mb-2 leading-relaxed">{description}</p>
        <div className="bg-gray-800 text-gray-200 text-xs p-2 rounded-md font-mono overflow-x-auto">
          <code>{code}</code>
        </div>
      </div>
    </div>
  </div>
  {!isLast && (
  <div className="h-8 flex items-center justify-center text-gray-400 my-1">
    <ArrowDown size={24} className="animate-pulse" />
  </div>
  )}
</div>
);

const PhaseContainer = ({ title, children, bgColor }) => (
<div className={`w-full max-w-2xl mx-auto p-6 rounded-2xl mb-6 ${bgColor} border border-opacity-50`}>
  <h2 className="text-xl font-extrabold text-gray-700 mb-6 text-center uppercase tracking-wider">{title}</h2>
  {children}
</div>
);

export default function App() {
return (
<div className="min-h-screen bg-gray-50 py-10 px-4 font-sans">
  <div className="max-w-4xl mx-auto">

    {/* Header */}
    <div className="text-center mb-12">
      <h1 className="text-3xl font-extrabold text-gray-900 mb-4">
        Génération de Heatmap via Transformée de Fourier (FFT)
      </h1>
      <p className="text-gray-600 max-w-2xl mx-auto">
        Pipeline de traitement d'image pour isoler les structures globales, seuiller les zones d'intérêt et générer une
        carte de chaleur superposée.
      </p>
    </div>

    {/* Start */}
    <div className="flex justify-center mb-6">
      <div className="bg-gray-800 text-white px-6 py-3 rounded-full font-bold shadow-lg flex items-center gap-2">
        <ImageIcon size={20} />
        Image Originale (Niveaux de gris)
      </div>
    </div>
    <div className="h-6 flex items-center justify-center text-gray-400 mb-2">
      <ArrowDown size={24} />
    </div>

    {/* Phase 1 */}
    <PhaseContainer title="Phase 1 : Filtrage Fréquentiel (Passe-Bas)" bgColor="bg-blue-50 border-blue-200">
      <DiagramStep icon={Activity} title="1. Transformée de Fourier (FFT)"
        description="Conversion de l'image du domaine spatial vers le domaine fréquentiel pour isoler les basses fréquences (volumes) des hautes fréquences (détails)."
        code="dft = cv2.dft(img_gray); dft_shift = fftshift(dft)" colorClass="border-blue-500" />
      <DiagramStep icon={Target} title="2. Application du Masque Circulaire"
        description="Création d'un masque noir avec un cercle blanc (rayon r) au centre. Multiplication avec le spectre pour supprimer les détails parasites."
        code="fshift = dft_shift * mask" colorClass="border-blue-500" />
      <DiagramStep icon={Cpu} title="3. Transformée Inverse (iDFT)"
        description="Retour au domaine spatial. L'image résultante est une version adoucie où seules les structures de base subsistent."
        code="img_back = magnitude(idft(ifftshift(fshift)))" colorClass="border-blue-500" isLast={true} />
    </PhaseContainer>

    <div className="h-6 flex items-center justify-center text-gray-400 mb-2">
      <ArrowDown size={24} />
    </div>

    {/* Phase 2 */}
    <PhaseContainer title="Phase 2 : Génération de la Heatmap" bgColor="bg-orange-50 border-orange-200">
      <DiagramStep icon={Sliders} title="4. Normalisation & Inversion"
        description="Étirement des contrastes de 0 à 255, puis inversion (Négatif) pour que les zones sombres d'origine deviennent les 'pics de chaleur' lumineux."
        code="heatmap_raw = 255 - normalize(img_back)" colorClass="border-orange-500" />
      <DiagramStep icon={Layers} title="5. Seuillage (Thresholding)"
        description="Suppression du bruit de fond. Tout pixel dont la valeur est inférieure au seuil (threshold_val) est forcé à zéro (noir)."
        code="cv2.threshold(..., threshold_val, THRESH_TOZERO)" colorClass="border-orange-500" />
      <DiagramStep icon={Palette} title="6. Colorisation (ColorMap)"
        description="Application d'un gradient de couleurs (bleu=froid, rouge=chaud) sur les pixels restants pour créer l'effet thermique."
        code="heatmap_color = applyColorMap(..., COLORMAP_JET)" colorClass="border-orange-500" isLast={true} />
    </PhaseContainer>

    <div className="h-6 flex items-center justify-center text-gray-400 mb-2">
      <ArrowDown size={24} />
    </div>

    {/* Phase 3 */}
    <PhaseContainer title="Phase 3 : Finalisation" bgColor="bg-green-50 border-green-200">
      <DiagramStep icon={ImageIcon} title="7. Superposition (Overlay)"
        description="Fusion de l'image d'origine (convertie en couleur) avec la Heatmap en appliquant un ratio de transparence (ex: 60% / 40%)."
        code="final = addWeighted(img_bgr, 0.6, heatmap, 0.4, 0)" colorClass="border-green-500" />
      <DiagramStep icon={Save} title="8. Sauvegarde sur Disque"
        description="Génération du nom de fichier incluant les paramètres utilisés et écriture de l'image finale."
        code="cv2.imwrite(save_path, final_overlay)" colorClass="border-green-500" isLast={true} />
    </PhaseContainer>

    {/* Footer / End */}
    <div className="flex justify-center mt-6">
      <div
        className="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-8 py-4 rounded-xl font-bold shadow-lg flex items-center gap-3">
        <ImageIcon size={24} />
        <span className="text-lg">Image Heatmap Finale</span>
      </div>
    </div>

  </div>
</div>
);
}